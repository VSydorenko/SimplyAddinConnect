	Попытка
		Успех = ОбъектДрайвераLP.ИнициализацияПринтера(ИДУстройстваLP);
		ВывестиРезультатLP("ИнициализацияПринтера = " + Строка(Успех) + ?(Успех, "", " | " + ПрочитатьОшибкуLP()));
