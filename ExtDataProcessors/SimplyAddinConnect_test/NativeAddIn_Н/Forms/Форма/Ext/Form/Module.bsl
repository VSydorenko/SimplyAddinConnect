# Область UAPKI

// Тестовий харнес компоненти AddinUAPKIConnect (ЕЦП/крипто через бібліотеку UAPKI).
// Послідовність: «Подключить компоненту» → «Створити обʼєкт UAPKI» → VERSION → INIT →
// OPEN → KEYS → SELECT_KEY → SIGN → VERIFY → CLOSE → DEINIT.
// Єдина точка входу компоненти — ВызватьUAPKI(<метод>, <json-параметри>) (docs/integration-1c/uapki.md §2).
// Обʼєкт ЖИВЕ між натисканнями кнопок (стан ініціалізації/відкритого НКІ — у C++), тому це
// клієнтська модульна Перем, а не локальна змінна й не реквізит форми.

&НаКлиенте
Процедура ВывестиРезультатUAPKI(Знач Текст)
	РезультатUAPKI = Строка(Текст);
	Сообщить(РезультатUAPKI);
КонецПроцедуры

&НаКлиенте
Функция ОбъектUAPKIГотов()
	Если ОбъектДрайвераUAPKI = Неопределено Тогда
		ВывестиРезультатUAPKI("Спочатку «Подключить компоненту», потім «Створити обʼєкт UAPKI»");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// --- Безпечне читання відповіді (JSON може не містити очікуваних полів) ---

&НаКлиенте
Функция ПолеСтруктуры(Знач Стр, Знач Имя, Знач ПоУмолчанию = Неопределено)
	Если ТипЗнч(Стр) <> Тип("Структура") Тогда Возврат ПоУмолчанию; КонецЕсли;
	Значение = Неопределено;
	Если НЕ Стр.Свойство(Имя, Значение) ИЛИ Значение = Неопределено Тогда Возврат ПоУмолчанию; КонецЕсли;
	Возврат Значение;
КонецФункции

&НаКлиенте
Функция ПолеРезультатаUAPKI(Знач Стр, Знач Имя, Знач ПоУмолчанию = Неопределено)
	Возврат ПолеСтруктуры(ПолеСтруктуры(Стр, "result"), Имя, ПоУмолчанию);
КонецФункции

&НаКлиенте
Функция ПервыйЭлемент(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("Массив") ИЛИ Значение.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;
	Возврат Значение[0];
КонецФункции

// Успіх операції — ТІЛЬКИ за errorCode = 0 (docs/integration-1c/uapki.md §3).
&НаКлиенте
Функция УспехUAPKI(Знач Стр)
	Возврат ПолеСтруктуры(Стр, "errorCode", -1) = 0;
КонецФункции

// Base64 без переносів рядків: Base64Строка ріже рядок кожні 76 символів, а декодер UAPKI
// чекає суцільний рядок.
&НаКлиенте
Функция Base64Сплошной(Знач ДвоичныеДанные)
	Текст = Base64Строка(ДвоичныеДанные);
	Текст = СтрЗаменить(Текст, Символы.ВК, "");
	Текст = СтрЗаменить(Текст, Символы.ПС, "");
	Возврат Текст;
КонецФункции

// Рядок → Base64 БЕЗ BOM (BOM зіпсував би підписаний XML).
&НаКлиенте
Функция ТекстВBase64(Знач Текст)
	Возврат Base64Сплошной(ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8", Ложь));
КонецФункции

// Спільна обгортка: викликає метод, пише сирий JSON у РезультатUAPKI, повертає розібрану
// структуру (або Неопределено, якщо виклик/розбір не вдався).
&НаКлиенте
Функция ВыполнитьUAPKI(Знач Метод, Знач Параметры = "")
	Если НЕ ОбъектUAPKIГотов() Тогда Возврат Неопределено; КонецЕсли;
	Попытка
		Ответ = ОбъектДрайвераUAPKI.ВызватьUAPKI(Метод, Параметры);
	Исключение
		ВывестиРезультатUAPKI("Помилка виклику " + Метод + ": " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	РезультатUAPKI = Строка(Ответ);
	Сообщить(Метод + " → " + Лев(РезультатUAPKI, 500));

	Стр = Неопределено;
	Попытка
		Стр = РаскодироватьJSON(РезультатUAPKI);
	Исключение
		Сообщить("Не вдалося розібрати JSON-відповідь " + Метод + ": " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ УспехUAPKI(Стр) Тогда
		Сообщить(Метод + ": помилка UAPKI, errorCode = " + Строка(ПолеСтруктуры(Стр, "errorCode", "?"))
			+ " " + Строка(ПолеСтруктуры(Стр, "error", "")));
	КонецЕсли;
	Возврат Стр;
КонецФункции

&НаКлиенте
Процедура СоздатьОбъектUAPKI(Команда)
	Попытка
		ОбъектДрайвераUAPKI = Новый("AddIn." + ПолучитьИмяКомпоненты() + ".AddinUAPKIConnect");
		ОбъектДрайвераUAPKI.ИспользоватьЛогирование("Trace", "C:\log\SimplyAddinConnect.log");
		ВывестиРезультатUAPKI("Обʼєкт AddinUAPKIConnect створено");
	Исключение
		ВывестиРезультатUAPKI("Помилка створення обʼєкта (чи підключена компонента?): " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// --- Будівники параметрів (через КодироватьJSON — коректне екранування слешів і лапок) ---

&НаКлиенте
Функция ПараметриINIT()
	П = Новый Структура;
	П.Вставить("offline", Истина);   // провайдери НКІ компонента інжектить сама (uapki.md §5)
	Возврат КодироватьJSON(П);
КонецФункции

&НаКлиенте
Функция ПараметриOPEN()
	П = Новый Структура;
	П.Вставить("provider", "PKCS12");
	П.Вставить("storage", СокрЛП(ШляхДоКлючаUAPKI));
	П.Вставить("password", ПарольКлючаUAPKI);
	П.Вставить("mode", "RO");
	Возврат КодироватьJSON(П);
КонецФункции

&НаКлиенте
Функция ПараметриSIGN()
	signParams = Новый Структура;
	signParams.Вставить("signatureFormat", "CAdES-BES");
	signParams.Вставить("signAlgo", "1.2.804.2.1.1.1.1.3.1.1");   // ДСТУ 4145
	signParams.Вставить("detachedData", Ложь);                    // enveloping — дані всередині підпису
	signParams.Вставить("includeCert", Истина);
	signParams.Вставить("includeTime", Истина);
	signParams.Вставить("includeContentTS", Ложь);

	Документ = Новый Структура;
	Документ.Вставить("id", "doc-0");
	Документ.Вставить("bytes", ТекстВBase64(ДаніДляПідпису));
	dataTbs = Новый Массив;
	dataTbs.Добавить(Документ);

	options = Новый Структура;
	options.Вставить("ignoreCertStatus", Истина);                 // тестовий ланцюг прострочений

	П = Новый Структура;
	П.Вставить("signParams", signParams);
	П.Вставить("dataTbs", dataTbs);
	П.Вставить("options", options);
	Возврат КодироватьJSON(П);
КонецФункции

&НаКлиенте
Функция ПараметриVERIFY()
	signature = Новый Структура;
	signature.Вставить("bytes", ПідписBase64);

	options = Новый Структура;
	options.Вставить("validationType", "STRUCT");   // офлайн, структурна перевірка
	options.Вставить("returnContent", Истина);      // повернути вкладений вміст (result.content.bytes)

	П = Новый Структура;
	П.Вставить("signature", signature);
	П.Вставить("options", options);
	Возврат КодироватьJSON(П);
КонецФункции

// Холістичний вердикт VERIFY — signatureInfos[0].status (uapki.md §4.5); statusSignature НЕ критерій.
&НаКлиенте
Функция СтатусПодписиUAPKI(Знач Стр)
	Инфо = ПервыйЭлемент(ПолеРезультатаUAPKI(Стр, "signatureInfos"));
	Возврат Строка(ПолеСтруктуры(Инфо, "status", ""));
КонецФункции

// Вкладений вміст підпису (result.content.bytes, Base64) → текст. Порожньо, якщо вмісту нема.
&НаКлиенте
Функция ВложенныйТекстUAPKI(Знач Стр)
	B64 = Строка(ПолеСтруктуры(ПолеРезультатаUAPKI(Стр, "content"), "bytes", ""));
	Если НЕ ЗначениеЗаполнено(B64) Тогда Возврат ""; КонецЕсли;
	Попытка
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(B64));
	Исключение
		Сообщить("Не вдалося декодувати вкладений вміст: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

