	Сообщить(ОбъектДрайвера.ПолучитьДоступныеПорты());
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПортСОМ(Команда)
	
	// Создаем объект компонента
	ОбъектДрайвера = Новый("AddIn.SimplyAddinConnect.SimplyConnect");
	
	// Указываем имя порта, который нас интересует
	
	ПортСуществует = ОбъектДрайвера.ПроверитьСуществованиеПорта(ИмяПорта);
	ПортДоступен = ОбъектДрайвера.ДоступенПорт(ИмяПорта);
	
	// Проверяем, существует ли и доступен ли порт
	Если ПортСуществует Тогда
		
		Если ПортДоступен Тогда
			
			// Если порт существует, доступен и еще не открыт объектом, открываем его
			Если ПортСуществует И ПортДоступен И НЕ ОбъектДрайвера.Открыт Тогда
				ОбъектДрайвера.ОткрытьПорт(ИмяПорта, СкоростьПорта);
				
				// Проверяем успешность открытия
				Если ОбъектДрайвера.Открыт Тогда
					// Порт успешно открыт, можно работать с ним
					Сообщить("Порт " + ИмяПорта + " успешно открыт");
					
				Иначе
					// Не удалось открыть порт
					Сообщить("Не удалось открыть порт " + ИмяПорта);
				КонецЕсли;
				
			ИначеЕсли НЕ ПортСуществует Тогда
				Сообщить("Порт " + ИмяПорта + " не существует в системе");
			ИначеЕсли НЕ ПортДоступен Тогда
				Сообщить("Порт " + ИмяПорта + " занят другим приложением");
			КонецЕсли;
			
		КонецЕсли
		
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПортСОМ(Команда)
	
	// Создаем объект компонента
	ОбъектДрайвера = Новый("AddIn.SimplyAddinConnect.SimplyConnect");
	//ОбъектДрайвера.ЗакрытьПорт();
	
	ПортСуществует = ОбъектДрайвера.ПроверитьСуществованиеПорта(ИмяПорта);
	ПортДоступен = ОбъектДрайвера.ДоступенПорт(ИмяПорта);
	
	// Проверяем, существует ли и доступен ли порт
	Если ПортСуществует Тогда
		
		Если ПортДоступен Тогда
			
			
			Если ПортСуществует И ПортДоступен И ОбъектДрайвера.Открыт Тогда
				
				// Закрытие порта
				ОбъектДрайвера.ЗакрытьПорт();
				Сообщить("Порт " + ИмяПорта + " успешно ЗАКРЫТ");
				
			Иначе
				// Не удалось закрыть порт
				Сообщить("Не удалось ЗАКРЫТЬ порт " + ИмяПорта);
			КонецЕсли;
			
		ИначеЕсли НЕ ПортСуществует Тогда
			Сообщить("Порт " + ИмяПорта + " не существует в системе");
		ИначеЕсли НЕ ПортДоступен Тогда
			Сообщить("Порт " + ИмяПорта + " занят другим приложением");
		КонецЕсли;
		
	КонецЕсли
	
КонецПроцедуры

