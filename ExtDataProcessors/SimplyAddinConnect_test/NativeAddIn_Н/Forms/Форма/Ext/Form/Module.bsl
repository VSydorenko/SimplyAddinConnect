Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	МакетКомпоненты = ОбработкаОбъект.ПолучитьМакет("NativeAddIn");
	МетоположениеКомпоненты = ПоместитьВоВременноеХранилище(МакетКомпоненты, УникальныйИдентификатор);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ФайлОбработки = Новый Файл(ОбработкаОбъект.ИспользуемоеИмяФайла);
	ТекущийКаталог = ФайлОбработки.Путь;
	
	// альтернативний метод підключення компоненти
	//МетоположениеКомпоненты = "R:\github\SMP_SimplyConnect\AddinConnect\bin\Release\SimplyAddinConnectWin_x86.dll";
	
	БольшоеЧисло = 3147483647;
	
	ИмяПорта = "COM4";
	СкоростьПорта = 115200;

	// ECR ПриватJSON — початкові значення для тесту проти емулятора (ecr_terminal_emulator).
	// Шлях до СВІЖОЇ збірки компоненти — вантажимо прямо з файлу (обхід застарілого макета).
	// Порожній → вбудований макет обробки. Виправте шлях під своє розташування репозиторію.
	ШляхДоКомпоненты = "R:\github\SimplyAddinConnect\bin\Release\SimplyAddinConnectWin.zip";
	СтрокаПодключения = "tcp://127.0.0.1:2000";
	Сумма = "1.00";
	RRN = "";
	НомерЧека = "";
	РезультатТекст = "";
	СтатусТерминалаТекст = "";

	// LabelPrinter — параметри підключення до ТЕСТОВОГО принтера (емулятор label_printer_emulator.exe на порту 9100).
	// Для реального принтера: TransportKind=spooler + PrinterName="<ім'я Windows-черги>".
	ПараметрыПодключенияLP =
	"<?xml version=""1.0"" encoding=""UTF-8""?>
	|<Parameters>
	|  <Parameter Name=""TransportKind"" Value=""tcp""/>
	|  <Parameter Name=""Host"" Value=""127.0.0.1""/>
