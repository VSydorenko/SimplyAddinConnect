# Область UAPKI_HTTP

// Раунд-тріп із консоллю-оракулом uapki_fiscal_emulator (грає приймаючу сторону — сервер ДПС).
// Запуск консолі: bin\Release\uapki_fiscal_emulator_x64.exe 8080
// Тіла HTTP — БІНАРНІ (DER CMS), тому шлемо/читаємо саме ДвоичныеДанные.

&НаКлиенте
Функция ПортКонсолиЧисло()
	Если НЕ ЗначениеЗаполнено(ПортКонсолі) Тогда Возврат 0; КонецЕсли;
	Попытка
		Возврат Число(СокрЛП(ПортКонсолі));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ОбменССервером(Знач Метод, Знач Ресурс, Знач ТелоДвоичное = Неопределено)
	Порт = ПортКонсолиЧисло();
	Если Порт <= 0 Тогда
		Сообщить("Некоректний порт консолі: «" + Строка(ПортКонсолі) + "»");
		Возврат Неопределено;
	КонецЕсли;
	Соединение = Новый HTTPСоединение(СокрЛП(ХостКонсолі), Порт, , , , 30);
	Запрос = Новый HTTPЗапрос(Ресурс);
	Если ТелоДвоичное <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/octet-stream");
		Запрос.УстановитьТелоИзДвоичныхДанных(ТелоДвоичное);
	КонецЕсли;
	Если ВРег(Метод) = "POST" Тогда
		Возврат Соединение.ОтправитьДляОбработки(Запрос);
	Иначе
		Возврат Соединение.Получить(Запрос);
	КонецЕсли;
КонецФункции

// Пояснення до відповіді консолі: текстове тіло показуємо як текст, бінарне — лише розміром.
&НаКлиенте
Функция ПояснениеОтветаКонсоли(Знач Ответ)
	ТипТела = "";
	Попытка
		Для Каждого КлючЗначение Из Ответ.Заголовки Цикл
			Если ВРег(Строка(КлючЗначение.Ключ)) = "CONTENT-TYPE" Тогда
				ТипТела = ВРег(Строка(КлючЗначение.Значение));
			КонецЕсли;
		КонецЦикла;
	Исключение
		ТипТела = "";
	КонецПопытки;
	Попытка
		Если Найти(ТипТела, "OCTET-STREAM") > 0 Тогда
			Тело = Ответ.ПолучитьТелоКакДвоичныеДанные();
			Возврат "бінарне тіло, " + ?(Тело = Неопределено, "0", Строка(Тело.Размер())) + " Б";
		КонецЕсли;
		Возврат Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 500);
	Исключение
		Возврат "тіло не читається: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

// Перевіряє підпис компонентою й показує вердикт + вкладений вміст. Підпис береться з ПідписBase64.
&НаКлиенте
Процедура ПроверитьПолученныйCMS(Знач Заголовок)
	Стр = ВыполнитьUAPKI("VERIFY", ПараметриVERIFY());
	Если НЕ УспехUAPKI(Стр) Тогда Возврат; КонецЕсли;
	Статус = СтатусПодписиUAPKI(Стр);
	Сообщить(Заголовок + ": вердикт " + Статус + ?(Статус = "TOTAL-VALID", " (валідний)", " (НЕ валідний)"));
	Вміст = ВложенныйТекстUAPKI(Стр);
	Если ЗначениеЗаполнено(Вміст) Тогда
		Сообщить(Заголовок + " (розгорнутий вміст): " + Лев(Вміст, 1000));
	Иначе
		Сообщить(Заголовок + ": вкладеного вмісту немає (result.content.bytes порожній)");
	КонецЕсли;
КонецПроцедуры

// Сценарій 1+3: підписати чек компонентою → POST /doc → розгорнути підписану квитанцію.
&НаКлиенте
Процедура ПодписатьИОтправитьUAPKI(Команда)
	Стр = ВыполнитьUAPKI("SIGN", ПараметриSIGN());
	Если НЕ УспехUAPKI(Стр) Тогда Возврат; КонецЕсли;
	Подпись = ПервыйЭлемент(ПолеРезультатаUAPKI(Стр, "signatures"));
	B64 = Строка(ПолеСтруктуры(Подпись, "bytes", ""));
	Если НЕ ЗначениеЗаполнено(B64) Тогда
		Сообщить("SIGN: у відповіді немає result.signatures[0].bytes");
		Возврат;
	КонецЕсли;
	ПідписBase64 = B64;

	Ответ = Неопределено;
	Попытка
		Ответ = ОбменССервером("POST", "/doc", Base64Значение(ПідписBase64));
	Исключение
		Сообщить("HTTP помилка (POST /doc): " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Если Ответ = Неопределено Тогда Возврат; КонецЕсли;

	Сообщить("Консоль відповіла: HTTP " + Строка(Ответ.КодСостояния));
	// 422 — консоль відхилила підпис; тіло — ТАКА САМА підписана квитанція (uapki.md §9),
	// лише з ERRORCODE=9 і причиною в ERRORTEXT. Розгортаємо її так само, як успішну.
	// Решта кодів (400/404/413/500) — текстове тіло з поясненням.
	Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 422 Тогда
		Сообщить("Документ НЕ прийнято консоллю. Відповідь: " + ПояснениеОтветаКонсоли(Ответ));
		Возврат;
	КонецЕсли;
	Відхилено = (Ответ.КодСостояния = 422);
	Если Відхилено Тогда
		Сообщить("Документ НЕ прийнято консоллю (HTTP 422) — розгортаю квитанцію-відмову");
	КонецЕсли;

	Попытка
		Квитанція = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Исключение
		Сообщить("Не вдалося прочитати тіло квитанції: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Если Квитанція = Неопределено ИЛИ Квитанція.Размер() = 0 Тогда
		Сообщить("Консоль повернула порожню квитанцію");
		Возврат;
	КонецЕсли;

	// Квитанція (бінарний CMS) → авто-VERIFY компонентою + видобуток вмісту (ticket01).
	// На 422 це та сама квитанція, але з ERRORCODE=9 — саме її вміст і є діагностикою відмови.
	ПідписBase64 = Base64Сплошной(Квитанція);
	ПроверитьПолученныйCMS(?(Відхилено, "Квитанція-відмова ДПС", "Квитанція ДПС"));
КонецПроцедуры

// Сценарій 2: запитати еталон із консолі → перевірити компонентою.
&НаКлиенте
Процедура ЗапроситьЭталонUAPKI(Команда)
	Ответ = Неопределено;
	Попытка
		Ответ = ОбменССервером("GET", "/reference?type=check");
	Исключение
		Сообщить("HTTP помилка (GET /reference): " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Если Ответ = Неопределено Тогда Возврат; КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("Консоль: HTTP " + Строка(Ответ.КодСостояния) + " — " + ПояснениеОтветаКонсоли(Ответ));
		Возврат;
	КонецЕсли;

	Попытка
		Эталон = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Исключение
		Сообщить("Не вдалося прочитати тіло еталона: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Если Эталон = Неопределено ИЛИ Эталон.Размер() = 0 Тогда
		Сообщить("Консоль повернула порожній еталон");
		Возврат;
	КонецЕсли;

	ПідписBase64 = Base64Сплошной(Эталон);
	ПроверитьПолученныйCMS("Еталон");
КонецПроцедуры

#КонецОбласти

# Область JSON

&НаКлиенте
Процедура КомандаВерсияJSON(Команда)
	
	//Сокет = Новый("AddIn.SimplyAddinConnect.AddinMSWinsock");
	////Сообщить(ОбъектДрайвера.ПолучитьДоступныеПорты());
