&НаКлиенте
Функция ОжиданиеОтвета(ОбъектДрайвера, СтруктураЗапроса) 
	ТипСоединения = 0;

	
	Команда = КодироватьJSON(СтруктураЗапроса) + Символ(0);	
	
					ПутьКФайлу = ПолучитьИмяВременногоФайла("txt");
					
					// Записываем строку в файл
					ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу);
					ЗаписьТекста.Записать(Команда);
					ЗаписьТекста.Закрыть();
					
					// Читаем файл как двоичные данные
					ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
					
					КомандаBase64 = Base64Строка(ДвоичныеДанные);
					ОбъектДрайвера.ЗаписатьДанныеБинарно(КомандаBase64);

	//ОбъектДрайвера.WriteData(Команда);
	
	Состояние(НСтр("ru='Ожидание банковского терминала';uk='Очікування банківського терміналу'"),,,);
	ВремяНачалаОжидания = ТекущаяДата(); 
	
	Если ТипСоединения = 1 Тогда
		СтрокаЗапроса = "ping -n 1 -w "+Формат(2000, "ЧДЦ=0; ЧГ=") + " " + СокрЛП("127.0.0.1"); 
		WshShell = Новый COMОбъект("WScript.Shell"); 
		WshShell.Run(СтрокаЗапроса, 0, -1); 
		РезультатЗапроса = "";
		
		Пока ОбъектДрайвера.BytesReceived = 0 и ВремяНачалаОжидания + 30 > ТекущаяДата() Цикл
			WshShell.Run(СтрокаЗапроса, 0, -1); 
		КонецЦикла;
		Буфер = "";
		РазмерБуфера = 0;
		ПолученоБайт = 0;
		ОбъектДрайвера.ReadData(РезультатЗапроса, РазмерБуфера, ПолученоБайт);
		//ОбъектДрайвера.ReadData(РезультатЗапроса); 
	Иначе 
		РезультатЗапроса = ОбъектДрайвера.input;
		Пока ПустаяСтрока(РезультатЗапроса) и ВремяНачалаОжидания + 30 > ТекущаяДата() Цикл
			РезультатЗапроса = ОбъектДрайвера.input;
		КонецЦикла;                             
	КонецЕсли;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла();
	ЗаписьТекста = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.ANSI);
	ЗаписьТекста.ЗаписатьСтроку(РезультатЗапроса);
	ЗаписьТекста.Закрыть();    
	
	Чтение = Новый ЧтениеТекста();
	Чтение.Открыть(ВременныйФайл, КодировкаТекста.UTF8);
	РезультатЗапроса = Чтение.Прочитать();
	Чтение.Закрыть();
	
	УдалитьФайлы(ВременныйФайл);
	
	РезультатЗапроса = РаскодироватьJSON(РезультатЗапроса);
	возврат РезультатЗапроса;
КонецФункции

&НаКлиенте
Функция КодироватьJSON(СтруктураЗапроса) 	       
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
	ТекстJSON = ЗаписьJSON.Закрыть();
	Возврат ТекстJSON;
КонецФункции	

&НаКлиенте
Функция РаскодироватьJSON(ТекстJSON)
	ЧтениеJSON = new ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);		
	СтруктураJSON = ПрочитатьJSON(ЧтениеJSON);	
	Возврат СтруктураJSON;	
КонецФункции

