	Сообщить(ОбъектДрайвера.ПолучитьТЕКСТ());
	
	ОбъектДрайвера.Число = БольшоеЧисло;
	ТипЗначения = ОбъектДрайвера.Число;
	
	ОбъектДрайвера.СоздатьТестовуюОшибку();
	
