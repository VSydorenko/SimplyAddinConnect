// Персистентний обʼєкт драйвера ECRPrivatJSON — ОДНА instance на форму, щоб зʼєднання
// з терміналом (стан у C++) жило між натисканнями кнопок. Створюється кнопкою
// "Створити обʼєкт" ПІСЛЯ "Подключить компоненту". Ім'я класу — ECRPrivatJSON.

&НаКлиенте
Процедура ВывестиРезультатECR(Знач Текст)
	РезультатТекст = Строка(Текст);
	Сообщить(РезультатТекст);
КонецПроцедуры

&НаКлиенте
Функция ОбъектECRГотов()
	Если ОбъектДрайвераECR = Неопределено Тогда
		ВывестиРезультатECR("Спочатку «Подключить компоненту», потім «Створити обʼєкт драйвера»");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция РасшифроватьСостояниеECR(Знач Код)
	Если    Код = 0 Тогда Возврат "0 Idle";
	ИначеЕсли Код = 1 Тогда Возврат "1 Running";
	ИначеЕсли Код = 2 Тогда Возврат "2 Interrupting";
	ИначеЕсли Код = 3 Тогда Возврат "3 Done";
	ИначеЕсли Код = 4 Тогда Возврат "4 Error";
	Иначе Возврат Строка(Код);
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура СоздатьОбъектДрайвераECR(Команда)
	Попытка
		ОбъектДрайвераECR = Новый("AddIn.SimplyAddinConnect.ECRPrivatJSON");
		ОбъектДрайвераECR.ИспользоватьЛогирование("Trace", "C:\log\SimplyAddinConnect.log");
		ВывестиРезультатECR("Обʼєкт драйвера ECRPrivatJSON створено");
	Исключение
		ВывестиРезультатECR("Помилка створення обʼєкта (чи підключена компонента?): " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьECR(Команда)
	Если НЕ ОбъектECRГотов() Тогда Возврат; КонецЕсли;
	Попытка
		Подключено = ОбъектДрайвераECR.Подключить(СокрЛП(СтрокаПодключения));
		ВывестиРезультатECR("Подключить(" + СтрокаПодключения + ") = " + Строка(Подключено));
	Исключение
		ВывестиРезультатECR("Помилка Подключить: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

