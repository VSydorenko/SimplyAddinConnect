&НаКлиенте
Процедура КомандаПодключитьCOMJSON(Команда)
	
	ОбъектДрайвера = Новый("AddIn.SimplyAddinConnect.AddinECRPrivatJSON");
	
	// Включаємо логування
	ОбъектДрайвера.ИспользоватьЛогирование("Trace", "C:\log\SimplyAddinConnect.log");
	
	Попытка
		Успешно = ОбъектДрайвера.ПодключитьCOM(ИмяПорта, СкоростьПорта);
		
		Если Успешно Тогда
			Сообщить("Порт " + ИмяПорта + " успешно подключен");
			// Дополнительная проверка соединения
			Если ОбъектДрайвера.ПроверитьСоединение() Тогда
				Сообщить("Проверка соединения успешна");
			Иначе
				Сообщить("Предупреждение: Порт открыт, но проверка соединения не прошла: " + 
				ОбъектДрайвера.ПолучитьПоследнееСообщениеОбОшибке());
			КонецЕсли;
		Иначе
			Сообщить("Не удалось подключить порт " + ИмяПорта + ": " + 
			ОбъектДрайвера.ПолучитьПоследнееСообщениеОбОшибке());
		КонецЕсли;
	Исключение
		Сообщить("Ошибка подключения: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

