// Вбудована подія форми: приймає ВнешнееСобытие від нашої компоненти (Источник = "ECRPrivatJSON").
// Событие = тип (state/status/result), Данные = JSON-рядок. Показуємо онлайн у полі СтатусТерминалаТекст.
// Опційно: якщо ВключитьСобытия не викликали — подій просто не буде, помилки нема.
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Если Источник <> "ECRPrivatJSON" Тогда Возврат; КонецЕсли;
	Стр = Неопределено;
	Попытка Стр = РаскодироватьJSON(Данные); Исключение КонецПопытки;
	Если ТипЗнч(Стр) <> Тип("Структура") Тогда
		СтатусТерминалаТекст = Событие + ": " + Данные;
		Возврат;
	КонецЕсли;

	Если Событие = "status" Тогда
		Текст = ""; Стр.Свойство("text", Текст);
		СтатусТерминалаТекст = "Статус: " + Текст;
	ИначеЕсли Событие = "state" Тогда
		Сост = ""; Стр.Свойство("state", Сост);
		СтатусТерминалаТекст = "Стан: " + Сост;
	ИначеЕсли Событие = "result" Тогда
		ОК = Ложь;  Стр.Свойство("ok", ОК);
		Код = "";   Стр.Свойство("code", Код);
		Опис = "";  Стр.Свойство("description", Опис);
		СтатусТерминалаТекст = ?(ОК, "Результат OK: ", "Результат ПОМИЛКА: ") + Код + " " + Опис;
	Иначе
		СтатусТерминалаТекст = Событие + ": " + Данные;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПринтерЭтикеток

// Тестовий харнес компоненти LabelPrinter (БПО-драйвер принтера етикеток).
// Послідовність: «Подключить компоненту» → «Створити обʼєкт LP» → «Подключить принтер»
// → (за потреби «Инициализировать») → «Напечатать этикетки».
// Тестовий принтер = емулятор label_printer_emulator.exe (порт 9100) АБО реальний ZPL-принтер
// (тоді у ПараметрыПодключенияLP: TransportKind=spooler, PrinterName=<ім'я Windows-черги>).

&НаКлиенте
Процедура ВывестиРезультатLP(Знач Текст)
	РезультатТекст = Строка(Текст);
	Сообщить(РезультатТекст);
КонецПроцедуры

&НаКлиенте
Функция ОбъектLPГотов()
	Если ОбъектДрайвераLP = Неопределено Тогда
		ВывестиРезультатLP("Спочатку «Подключить компоненту», потім «Створити обʼєкт LP»");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ПрочитатьОшибкуLP()
	Опис = "";
	Код = ОбъектДрайвераLP.ПолучитьОшибку(Опис);
	Возврат "код " + Строка(Код) + " — " + Опис;
КонецФункции

&НаКлиенте
Процедура СоздатьОбъектДрайвераLP(Команда)
	Попытка
		ОбъектДрайвераLP = Новый("AddIn." + ПолучитьИмяКомпоненты() + ".LabelPrinter");
		ОбъектДрайвераLP.ИспользоватьЛогирование("Trace", "C:\log\SimplyAddinConnect.log");
		ВывестиРезультатLP("Обʼєкт драйвера LabelPrinter створено. Ревізія інтерфейсу: "
			+ Строка(ОбъектДрайвераLP.ПолучитьРевизиюИнтерфейса()));
	Исключение
		ВывестиРезультатLP("Помилка створення обʼєкта (чи підключена компонента?): " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьПринтерLP(Команда)
	Если НЕ ОбъектLPГотов() Тогда Возврат; КонецЕсли;
	Попытка
		ИДУстройстваLP = "";
		Успех = ОбъектДрайвераLP.ПодключитьОборудование(ИДУстройстваLP, "LabelPrinter", СокрЛП(ПараметрыПодключенияLP));
		ВывестиРезультатLP("ПодключитьОборудование = " + Строка(Успех) + "; DeviceID = " + ИДУстройстваLP
			+ ?(Успех, "", " | " + ПрочитатьОшибкуLP()));
	Исключение
		ВывестиРезультатLP("Помилка ПодключитьОборудование: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьПринтерLP(Команда)
	Если НЕ ОбъектLPГотов() Тогда Возврат; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИДУстройстваLP) Тогда ВывестиРезультатLP("Спочатку «Подключить принтер»"); Возврат; КонецЕсли;
	Попытка
		Успех = ОбъектДрайвераLP.ИнициализацияПринтера(ИДУстройстваLP);
		ВывестиРезультатLP("ИнициализацияПринтера = " + Строка(Успех) + ?(Успех, "", " | " + ПрочитатьОшибкуLP()));
	Исключение
		ВывестиРезультатLP("Помилка ИнициализацияПринтера: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЭтикеткиLP(Команда)
	Если НЕ ОбъектLPГотов() Тогда Возврат; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИДУстройстваLP) Тогда ВывестиРезультатLP("Спочатку «Подключить принтер»"); Возврат; КонецЕсли;
	Попытка
		Успех = ОбъектДрайвераLP.ПечатьЭтикеток(ИДУстройстваLP, LabelsTableXML, "first");
		ВывестиРезультатLP("ПечатьЭтикеток('first') = " + Строка(Успех)
			+ ?(Успех, " — пакет надіслано на принтер/емулятор", " | " + ПрочитатьОшибкуLP()));
	Исключение
		ВывестиРезультатLP("Помилка ПечатьЭтикеток: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

