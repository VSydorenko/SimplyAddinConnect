&НаКлиенте
Процедура КомандаSIGNUAPKI(Команда)
	Стр = ВыполнитьUAPKI("SIGN", ПараметриSIGN());
	Если НЕ УспехUAPKI(Стр) Тогда Возврат; КонецЕсли;
	Подпись = ПервыйЭлемент(ПолеРезультатаUAPKI(Стр, "signatures"));
	B64 = Строка(ПолеСтруктуры(Подпись, "bytes", ""));
	Если НЕ ЗначениеЗаполнено(B64) Тогда
		Сообщить("SIGN: у відповіді немає result.signatures[0].bytes");
		Возврат;
	КонецЕсли;
	ПідписBase64 = B64;
	Сообщить("Підпис отримано (" + Строка(СтрДлина(ПідписBase64)) + " симв. Base64)");
КонецПроцедуры

&НаКлиенте
Процедура КомандаVERIFYUAPKI(Команда)
	Если НЕ ЗначениеЗаполнено(ПідписBase64) Тогда
		ВывестиРезультатUAPKI("Немає підпису для перевірки — спочатку SIGN (або отримайте еталон)");
		Возврат;
	КонецЕсли;
	Стр = ВыполнитьUAPKI("VERIFY", ПараметриVERIFY());
	Если НЕ УспехUAPKI(Стр) Тогда Возврат; КонецЕсли;
	Статус = СтатусПодписиUAPKI(Стр);
	Инфо = ПервыйЭлемент(ПолеРезультатаUAPKI(Стр, "signatureInfos"));
	Сообщить("Вердикт: " + Статус + ?(Статус = "TOTAL-VALID", " (валідний)", " (НЕ валідний)")
		+ " | validSignatures = " + Строка(ПолеСтруктуры(Инфо, "validSignatures", "?"))
		+ ", validDigests = " + Строка(ПолеСтруктуры(Инфо, "validDigests", "?")));
	Вміст = ВложенныйТекстUAPKI(Стр);
	Если ЗначениеЗаполнено(Вміст) Тогда
		Сообщить("Вкладений вміст: " + Лев(Вміст, 1000));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаDIGESTUAPKI(Команда)
	П = Новый Структура;
	П.Вставить("bytes", ТекстВBase64(ДаніДляПідпису));
	// ГОСТ 34311-95 — геш «старої» схеми (OID_GOST34311 в extern/uapki/.../pkix/oids.h), саме він
	// у тест-ключі test-diia.p12 і в сценарії tests/scenarios/02_digest.json.
	// Для «нової» схеми ПРРО (з 01.09.2026) геш — Купина-256, OID "1.2.804.2.1.1.1.1.2.2.1".
	П.Вставить("hashAlgo", "1.2.804.2.1.1.1.1.2.1");
	ВыполнитьUAPKI("DIGEST", КодироватьJSON(П));
КонецПроцедуры

