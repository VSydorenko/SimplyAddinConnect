# Нормалізація кінців рядків.
#
# `text=auto` — у РЕПОЗИТОРІЇ зберігаємо LF, у робочій копії git віддає те, що
# природне для платформи. Це прибирає шум «CRLF will be replaced by LF» і робить
# diff однаковим незалежно від того, хто й на чому редагував.
#
# УВАГА: у проєкті є місця, де байти мають значення, і нормалізація їх МОВЧКИ
# ламає. Вони перелічені нижче й додатково захищені власними .gitattributes у
# своїх каталогах (правило з глибшого каталогу має пріоритет над кореневим).

* text=auto

# --- Скрипти під Windows -----------------------------------------------------
# PowerShell працює з обома варіантами, але CRLF у робочій копії — те, що очікує
# редактор і консоль на цільовій платформі проєкту.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# --- Джерела й документація --------------------------------------------------
*.cpp   text
*.h     text
*.cmake text
*.txt   text
*.md    text
*.json  text
*.yaml  text
*.xml   text
*.def   text
*.rc    text

# --- Бінарні формати: жодної нормалізації ------------------------------------
*.p12 binary
*.pfx binary
*.cer binary
*.crt binary
*.p7s binary
*.crl binary
*.bin binary
*.dll binary
*.lib binary
*.exe binary
*.zip binary
*.epf binary
*.erf binary
*.png binary
*.jpg binary
*.ico binary

# --- Тестові дані: байт-у-байт незмінні ---------------------------------------
# Підписи рахувалися над КОНКРЕТНИМИ байтами вхідних файлів. Нормалізація
# "Test\r\n" (6 Б) -> "Test\n" (5 Б) мовчки ламає detached-перевірку: підпис
# лишається валідним за структурою, але не збігається з вмістом. Помилка при
# цьому виглядає як дефект крипто-стека, а не як зіпсований тестовий вектор —
# тому тут вимкнено все, включно з .txt, який вище оголошений текстовим.
tests/data/** -text

# --- Заголовки SDK 1С ---------------------------------------------------------
# «DO NOT ALTER THIS FILE» — чужий код, віддаємо як прийшов.
include/** -text
